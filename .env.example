# Copie ce fichier en .env.local pour lancer le site en local avec les comptes.
# Sur Vercel, l'intégration Supabase remplit ces variables automatiquement.
# Valeurs à trouver dans Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-publique
# (ou NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY si ton projet utilise les nouvelles clés)

# --- Côté serveur uniquement (jamais de préfixe NEXT_PUBLIC_) ---
# Clé secrète Supabase : indispensable pour jouer (progression, jetons, abonnements).
SUPABASE_SECRET_KEY=

# Paiements Stripe (laisser vide = offres « bientôt disponibles »).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_STANDARD=

# E-mails de vérification étudiante (Resend).
RESEND_API_KEY=
EMAIL_FROM=
